dist/
build/

# Secrets. The .example files are committed; the real ones never are.
.env
.env.*
!.env.example

# Raw LinkedIn captures are credential-bearing: LinkedIn embeds data-csrf, whose
# value is the JSESSIONID verbatim. Only redacted fixtures belong in git.
fixtures/raw/
*.raw.html

*.log
*.tmp.mjs
.vite/
.DS_Store
Thumbs.db

# Incremental TypeScript build state: machine-local, regenerated on every build.
*.tsbuildinfo

# Sign-in failure captures: screenshots and page text of a half-authenticated
# session. Diagnostic only, never committed.
server/debug/
