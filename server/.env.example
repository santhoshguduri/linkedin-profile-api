# ---------------------------------------------------------------------------
# LinkedIn session
#
# A cookie is the only way in. LinkedIn retired form-based sign-in: its login
# page encrypts the password in the browser and attaches a device fingerprint,
# so an email and password cannot be exchanged for a session by a server.
#
# Sign in to LinkedIn in a browser, open DevTools > Application > Cookies, and
# copy these. Revoke them at any time by signing that session out.
# Leave blank to run the API as a bring-your-own-cookie service: callers then
# supply their own session per request.
# ---------------------------------------------------------------------------
LI_AT=
LI_JSESSIONID=

# Optional extra cookies. Not required; they slightly improve session stability.
LI_BCOOKIE=
LI_LIDC=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated origins allowed to call the API, or * for any.
# Set this to your deployed client URL in production.
CORS_ORIGIN=*

# Optional shared secret. When set, /api/profile requires x-api-key.
API_KEY=

# Whether callers may attach their own LinkedIn session to a request, instead of
# borrowing the one above. Set to false to pin every lookup to this deployment's
# own session.
ALLOW_REQUEST_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
INBOUND_RPM=30            # requests per minute per client IP
OUTBOUND_RPM=6            # requests per minute to LinkedIn; >6 invites HTTP 999
SECTION_CONCURRENCY=3     # parallel /details/ page fetches
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
REQUEST_TIMEOUT_MS=20000

# Optional outbound proxy. Strongly recommended for a public deploy: LinkedIn
# rate-limits datacenter IP ranges aggressively.
PROXY_URL=
