# ---------------------------------------------------------------------------
# LinkedIn session -- option A: a cookie (preferred for an unattended deploy)
#
# Nothing is launched and nobody is prompted: the server just uses it. Sign in
# to LinkedIn in a browser, open DevTools > Application > Cookies and copy these.
# Revoke at any time by signing that session out from LinkedIn's device list.
#
# Leave every value in this section blank to run the API as a bring-your-own-
# session service: callers then sign in or send a cookie per request.
# ---------------------------------------------------------------------------
LI_AT=
LI_JSESSIONID=

# Optional extra cookies. Not required; they slightly improve session stability.
LI_BCOOKIE=
LI_LIDC=

# ---------------------------------------------------------------------------
# LinkedIn session -- option B: an email and password
#
# Used only when LI_AT above is empty. The server drives Chromium through
# LinkedIn's real sign-in page, because the password is encrypted by LinkedIn's
# own JavaScript and signed with a device fingerprint -- neither of which can be
# reproduced by an HTTP client.
#
# Expect a one-time prompt in the LinkedIn mobile app the first time a given
# host signs in: LinkedIn treats a new server IP as a new device. Nobody can tap
# that for you, so an unattended deploy should prefer option A. The harvested
# cookie is held in memory only and is lost on restart.
# ---------------------------------------------------------------------------
LI_USERNAME=
LI_PASSWORD=

# Whether this deployment may launch a browser at all. false makes the API
# cookie-only and /api/auth/login returns LOGIN_UNAVAILABLE -- the right setting
# for a host without Chromium or with little spare memory.
BROWSER_LOGIN=true

# false shows the browser window. Only useful when debugging a sign-in locally;
# a server has no display.
BROWSER_HEADLESS=true

# How long one sign-in request blocks waiting for the phone tap before it
# answers "still waiting" and lets the caller poll again. Keep it under whatever
# your platform's proxy allows (usually 30s).
LOGIN_WAIT_MS=20000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated origins allowed to call the API, or * for any.
# Set this to your deployed client URL in production.
CORS_ORIGIN=*

# Optional shared secret. When set, /api/profile requires x-api-key.
API_KEY=

# Whether callers may sign in, or attach their own LinkedIn session to a
# request, instead of borrowing the one above. Set to false to pin every lookup
# to this deployment's own session and disable /api/auth entirely.
ALLOW_REQUEST_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
INBOUND_RPM=30            # requests per minute per client IP
OUTBOUND_RPM=6            # requests per minute to LinkedIn; >6 invites HTTP 999
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
REQUEST_TIMEOUT_MS=20000

# Load each profile in a real browser so LinkedIn's own runtime fetches the
# sections. Everything below the top card -- experience, education, skills --
# is absent from the HTML LinkedIn serves, so turning this off returns the top
# card and nothing else. Costs a Chromium page and ~10s per profile.
RENDER_PROFILES=true

# Ceiling on one render. Long profiles genuinely take tens of seconds; too low
# a value truncates them silently rather than failing.
RENDER_TIMEOUT_MS=45000

# Optional outbound proxy. Strongly recommended for a public deploy: LinkedIn
# rate-limits datacenter IP ranges aggressively.
PROXY_URL=

# When a sign-in stalls, dump the page it stalled on (screenshot + text) here.
# Leave unset outside debugging: the captures show a half-authenticated session.
# Pair it with BROWSER_HEADLESS=false to watch the sign-in happen live.
# LOGIN_DEBUG_DIR=./debug
