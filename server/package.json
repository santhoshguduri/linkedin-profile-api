{
  "name": "linkedin-profile-api-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that turns a LinkedIn profile URL into structured JSON.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "decode": "tsx scripts/decode.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "playwright": "1.62.1",
    "tough-cookie": "^5.1.0",
    "undici": "^7.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
